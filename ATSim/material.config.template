# Thermal conductivity in W/(m K), volumetric heat capacity in J/(m^3 K).
# C4, TSV and Ubump retain the original area-fraction homogenized properties.
# Copper fraction = (diameter / pitch)^2; conductivity and capacity are volume-weighted.
# C4: 250/600 um; TSV: 10/50 um; Ubump: 25/45 um.

[Substrate]
type = Solid
non_linear = False
conductivity (w/(m-k)) = ${substrate_conductivity}
volumetric heat capacity (j/(m3-k)) = ${substrate_volumetric_capacity}

